@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьУчетнуюЗапись(): УчетныеЗаписи.Ссылка?
    знч Пользватель = Пользователи.ТекущийПользователь
    знч Запрос = Запрос{
        ВЫБРАТЬ
            УчетныеЗаписи.Ссылка КАК Ссылка
            
        ИЗ
            УчетныеЗаписи КАК УчетныеЗаписи
        ГДЕ 
            УчетныеЗаписи.Пользователь == %Пользватель
    }
    возврат Запрос.Выполнить().Пусто() ? Неопределено : Запрос.Выполнить().ПервыйИлиНеопределено().Ссылка 
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьУчетнуюЗапись(Пользватель: Пользователи.Ссылка): УчетныеЗаписи.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            УчетныеЗаписи.Ссылка КАК Ссылка
            
        ИЗ
            УчетныеЗаписи КАК УчетныеЗаписи
        ГДЕ 
            УчетныеЗаписи.Пользователь == %Пользватель
    }
    возврат Запрос.Выполнить().Пусто() ? Неопределено : Запрос.Выполнить().ПервыйИлиНеопределено().Ссылка 
;