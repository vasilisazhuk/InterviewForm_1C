импорт ПраваДоступа


@Обработчик
метод ВычислитьРазрешенияДоступа(): ЧитаемаяКоллекция<РазрешениеДоступа>
    // TODO Вставить содержимое обработчика
    возврат []
;
@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(Объекты: ЧитаемыйМассив<Опросы.ДанныеРасчетаРазрешений>): ЧитаемоеСоответствие<Опросы.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
   знч Результат = <Опросы.ДанныеРасчетаРазрешений, Массив<РазрешениеДоступа>>{:}

   для Объект из Объекты
      знч Разрешения = <РазрешениеДоступа>[
         новый РазрешениеДоступа(
                [новый КлючДоступаОпрос.Объект(Владелец = Объект.Ссылка)],
                [Сущность.Право.Изменение, Сущность.Право.Удаление])]

      Результат.Вставить(Объект, Разрешения)
   ;

   возврат Результат
;