импорт НСИ::Опросники
импорт НСИ

@Обработчик
метод ПроверитьНаличиеКлючейДоступа(Ключи: ЧитаемыйМассив<КлючДоступаОпрос.Объект>,
        Пользователи: ЧитаемыйМассив<Пользователи.Ссылка>): ЧитаемоеСоответствие<КлючДоступаОпрос.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>
    // TODO Вставить содержимое обработчика
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Опросы.Ссылка КАК Ссылка,
            УчетныеЗаписи.Пользователь КАК Пользователь
        ИЗ
            Опросы КАК Опросы
                ЛЕВОЕ СОЕДИНЕНИЕ УчетныеЗаписи КАК УчетныеЗаписи
                ПО Опросы.Автор == УчетныеЗаписи.Ссылка
        ГДЕ
            УчетныеЗаписи.Пользователь В (%Пользователи)
    }
    знч АвторыОпрсов = <Опросы.Ссылка, Массив<Пользователи.Ссылка>>{:}
    исп РезультатЗапроса = Запрос.Выполнить()
    для Элемент из РезультатЗапроса
        если Элемент.Пользователь != Null
            АвторыОпрсов.ВставитьЕслиОтсутствует(Элемент.Ссылка, <Пользователи.Ссылка>[])
            АвторыОпрсов.Получить(Элемент.Ссылка).Добавить(Элемент.Пользователь как Пользователи.Ссылка?)
        ;
    ;
    знч Опросы = <КлючДоступаОпрос.Объект, ЧитаемаяКоллекция<Пользователи.Ссылка>>{:}
    для Ключ из Ключи
        знч Автор = АвторыОпрсов.ПолучитьИлиНеопределено(Ключ.Владелец)
        если Автор != Неопределено
            Опросы.Вставить(Ключ, Автор)
        ;
    ;
    
    возврат Опросы
;