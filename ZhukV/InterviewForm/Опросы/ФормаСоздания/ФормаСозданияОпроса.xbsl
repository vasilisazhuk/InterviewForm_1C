импорт НСИ::Опросники

метод СписокВопросовПриНажатииСтроки(Источник: Список<ДинамическийСписок>,
        Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка>>)

    знч Номер = Событие.Данные.ДанныеСтроки.Данные["НомерВопроса"] как Число //Событие.Данные["НомерВопроса"] как Число
    знч ТипОтвета = Событие.Данные.ДанныеСтроки.Данные["ТипОтвета"] как ТипОтвета
    знч ТекстВопрос = Событие.Данные.ДанныеСтроки.Данные["ТекстВопрос"].ВСтроку()
    знч РасшифровкаВопроса = Событие.Данные.ДанныеСтроки.Данные["РасшифровкаВопроса"].ВСтроку()

    ФормаСозданиеВопроса.ОткрытьВМодальномОкне(Опрос_св = Объект.Ссылка, НомерВопроса_св = Номер,
        Вопрос_св = ТекстВопрос, Подсказка_св = РасшифровкаВопроса, Тип_св = ТипОтвета)
;

метод СохранитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Записано_св = Истина
    Записать()
    //СохранитьНаСервере(Объект)
    Компоненты.ГруппаВопросы.Видимость = Истина
    Компоненты.ГруппаРесподенты.Видимость = Объект.Анонимный
;

метод ПрикрепитьДекорациюПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    ФормаПрикрепленияДекораций.ОткрытьВМодальномОкне(ОпросОбъект_св = Объект)
;

метод ДобавитьВопросПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    пер ТекущийНомер = ТекущийНомерВопроса(Объект.Ссылка)
    ФормаСозданиеВопроса.ОткрытьВМодальномОкне(Опрос_св = Объект.Ссылка, НомерВопроса_св = ТекущийНомер)
;

@НаСервере @ДоступноСКлиента
статический метод ТекущийНомерВопроса(Опрос: Опросы.Ссылка?): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ВопросыДляОпроса.НомерВопроса КАК НомерВопроса
        ИЗ
            ВопросыДляОпроса КАК ВопросыДляОпроса
        ГДЕ
            ВопросыДляОпроса.Опрос == %Опрос
        УПОРЯДОЧИТЬ ПО
            НомерВопроса УБЫВ
    }
    если Запрос.Выполнить().Пусто()
        возврат 0
    иначе
        пер Номер = Запрос.Выполнить().ПервыйИлиНеопределено().НомерВопроса
        возврат Номер + 1
    ;
;

метод ВопросыПриСозданииСтроки(
        Источник: Список<ДинамическийСписок<ZhukV::InterviewForm::НСИ::Опросники::ВопросыДляОпроса.АвтоматическаяФормаСписка.ДанныеСтрокиСписка, ZhukV::InterviewForm::НСИ::Опросники::ВопросыДляОпроса.АвтоматическаяФормаСписка.ДанныеСтрокиСписка>>,
        Событие: СобытиеПриСозданииСтроки<Объект>)

    пер ТекущийНомер = ТекущийНомерВопроса(Объект.Ссылка)
    ФормаСозданиеВопроса.ОткрытьВМодальномОкне(Опрос_св = Объект.Ссылка, НомерВопроса_св = ТекущийНомер)
;