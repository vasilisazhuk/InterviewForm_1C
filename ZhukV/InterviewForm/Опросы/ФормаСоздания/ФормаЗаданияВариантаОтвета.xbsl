@НаСервере @ДоступноСКлиента
статический метод СохранитьВариантОтвета(Опрос: Опросы.Ссылка?, НомерВопроса: Число)
    знч Запрос = Запрос{
        ВЫБРАТЬ 
            ВариантыОтветаИзМножества.НомерВарианта как НомерВарианта
        ИЗ 
            ВариантыОтветаИзМножества КАК ВариантыОтветаИзМножества
    }
;