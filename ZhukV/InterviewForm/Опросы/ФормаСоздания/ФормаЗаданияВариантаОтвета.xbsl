импорт НСИ::Опросники

метод Кнопка1ПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    //СохранитьВариантОтвета(Опрос_св, НомерВопроса_св, Компоненты.ПолеВвода1.Значение)
    пер ТекущийНомер = ТекущийНомер(Опрос_св, НомерВопроса_св) + 1
    СохранитьВариантОтвета(Опрос_св, НомерВопроса_св, НомерВарианта_св, Компоненты.ПолеВвода1.Значение)
    Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СохранитьВариантОтвета(Опрос: Опросы.Ссылка?, НомерВопроса: Число,
        НомерВарианта: Число,
        Значение: Строка)

    пер КлючЗаписи = новый ВариантыОтветаИзМножества.КлючЗаписи(Опрос = Опрос, НомерВопроса = НомерВопроса,
    НомерВарианта = НомерВарианта)
    пер Запись = КлючЗаписи.ЗагрузитьЗапись()

    если Запись != Неопределено
        ВариантыОтветаИзМножества.Удалить(КлючЗаписи)
    ;
    Запись = новый ВариантыОтветаИзМножества.Запись(Опрос = Опрос, НомерВопроса = НомерВопроса,
        НомерВарианта = НомерВарианта, Значение = Значение)
    ВариантыОтветаИзМножества.Записать(Запись)
;

@НаСервере @ДоступноСКлиента
статический метод ТекущийНомер(Опрос: Опросы.Ссылка?, НомерВопроса: Число): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ВариантыОтветаИзМножества.НомерВарианта КАК НомерВарианта
        ИЗ
            ВариантыОтветаИзМножества КАК ВариантыОтветаИзМножества
        ГДЕ
            ВариантыОтветаИзМножества.Опрос == %Опрос
             И ВариантыОтветаИзМножества.НомерВопроса == %НомерВопроса
        УПОРЯДОЧИТЬ ПО
            ВариантыОтветаИзМножества.НомерВарианта УБЫВ
    }
    возврат Запрос.Выполнить().Пусто() ? 0 : Запрос.Выполнить().ПервыйИлиНеопределено().НомерВарианта
;