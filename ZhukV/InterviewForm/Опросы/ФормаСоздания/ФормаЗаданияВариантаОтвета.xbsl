импорт НСИ::Опросники

метод Кнопка1ПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    СохранитьВариантОтвета(Опрос_св, НомерВопроса_св, Компоненты.ПолеВвода1.Значение)
    Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СохранитьВариантОтвета(Опрос: Опросы.Ссылка?, НомерВопроса: Число, Вариант: Строка)
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ВариантыОтветаИзМножества.НомерВарианта КАК НомерВарианта
        ИЗ
            ВариантыОтветаИзМножества КАК ВариантыОтветаИзМножества
        ГДЕ
            ВариантыОтветаИзМножества.Опрос == %Опрос
             И ВариантыОтветаИзМножества.НомерВопроса == %НомерВопроса
        УПОРЯДОЧИТЬ ПО
            ВариантыОтветаИзМножества.НомерВарианта УБЫВ
    }
    знч НомерВарианта = Запрос.Выполнить().Пусто() ? 0 : Запрос.Выполнить().ПервыйИлиНеопределено().НомерВарианта
    знч КлючЗаписи = новый ВариантыОтветаИзМножества.Запись(Опрос = Опрос, НомерВопроса = НомерВопроса, НомерВарианта = НомерВарианта + 1, Значение = Вариант).Заполнить()
    ВариантыОтветаИзМножества.Записать(КлючЗаписи)
    //пер Запись = новый ВариантыОтветаИзМножества.Запись(КлючЗапи)
    //знч Запись = новый ВариантыОтветаИзМножества.Запись(КлючЗаписи)
;