    знч ЗагружаемоеФото = Событие.НовоеЗначение.Получить(0)
    ОпросОбъект_св.ИзображениеКонец = ЗагрузкаФайлов.НачатьЗагрузку(ЗагружаемоеФото).ПолучитьРезультат()
    //Компоненты.Картинка2.Изображение = ЗагрузкаФайлов.НачатьЗагрузку(ЗагружаемоеФото).ПолучитьРезультат()
    Компоненты.ВыборФайлов2.Видимость = Ложь
;

