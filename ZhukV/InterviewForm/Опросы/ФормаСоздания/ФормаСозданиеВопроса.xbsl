импорт НСИ::Опросники

метод ЗадатьВариантОтветаПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    ФормаЗаданияВариантаОтвета.ОткрытьВМодальномОкне(Опрос_св = Опрос_св, НомерВопроса_св = НомерВопроса_св)
;

метод ЗаписатьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    СохранитьВопрос(Опрос_св, НомерВопроса_св, Компоненты.ТипВопроса.Значение, Компоненты.Вопрос.Значение, Компоненты
            .Подсказка.Значение)
    Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СохранитьВопрос(Опрос: Опросы.Ссылка?, НомерВопроса: Число, Тип: ТипОтвета, Вопрос: Строка,
        Подсказка: Строка)

    пер КлючЗаписи = новый ВопросыДляОпроса.КлючЗаписи(Опрос = Опрос, НомерВопроса = НомерВопроса)
    пер Запись = КлючЗаписи.ЗагрузитьЗапись()

    если Запись != Неопределено
        ВопросыДляОпроса.Удалить(КлючЗаписи)
        если Тип == ТипОтвета.МножественныйВыбор или Тип == ТипОтвета.ОдиночныйВыбор
            знч Запрос = Запрос{
                ВЫБРАТЬ
                    ВариантыОтветаИзМножества.НомерВарианта КАК НомерВарианта
                ИЗ
                    ВариантыОтветаИзМножества КАК ВариантыОтветаИзМножества
                ГДЕ
                    ВариантыОтветаИзМножества.Опрос == %Опрос
                     И ВариантыОтветаИзМножества.НомерВопроса == %НомерВопроса
                УПОРЯДОЧИТЬ ПО
                    ВариантыОтветаИзМножества.НомерВарианта УБЫВ
            }
            знч РезультатЗапроса = Запрос.Выполнить()
            для Элемент из РезультатЗапроса
                пер КлючВарианта =
                    новый ВариантыОтветаИзМножества.КлючЗаписи(Опрос = Опрос, НомерВопроса = НомерВопроса,
                    НомерВарианта = Элемент.НомерВарианта)
                ВариантыОтветаИзМножества.Удалить(КлючВарианта)
            ;
        ;
    ;
    Запись = новый ВопросыДляОпроса.Запись(Опрос = Опрос, НомерВопроса = НомерВопроса, ТипОтвета = Тип,
        ТекстВопроса = Вопрос, РасшифровкаВопроса = Подсказка)
    ВопросыДляОпроса.Записать(Запись)
;