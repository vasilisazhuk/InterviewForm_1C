импорт НСИ::Опросники

метод ЗаписатьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    СохранитьВопрос(Опрос_св, НомерВопроса_св, Компоненты.ТипВопроса.Значение, Компоненты.Вопрос.Значение, Компоненты
            .Подсказка.Значение)
    Закрыть()
;

@НаСервере @ДоступноСКлиента
статический метод СохранитьВопрос(Опрос: Опросы.Ссылка?, НомерВопроса: Число, Тип: ТипОтвета, Вопрос: Строка,
        Подсказка: Строка)

    пер КлючЗаписи = новый ВопросыДляОпроса.КлючЗаписи(Опрос = Опрос, НомерВопроса = НомерВопроса)
    пер Запись = КлючЗаписи.ЗагрузитьЗапись()

    если Запись != Неопределено
        ВопросыДляОпроса.Удалить(КлючЗаписи)
        если Тип == ТипОтвета.МножественныйВыбор или Тип == ТипОтвета.ОдиночныйВыбор

        ;
    ;
    Запись = новый ВопросыДляОпроса.Запись(Опрос = Опрос, НомерВопроса = НомерВопроса, ТипОтвета = Тип,
        ТекстВопроса = Вопрос, РасшифровкаВопроса = Подсказка)
    ВопросыДляОпроса.Записать(Запись)
;